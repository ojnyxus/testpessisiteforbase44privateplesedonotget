# Non-secret local defaults for the Base44 dev stack.
# Listed FIRST in docker-compose.base44.yml env_file, so values delivered by the
# platform to /run/base44/app.env always take precedence.
APP_NAME=BlockForge Hub
APP_TAGLINE=Modpacks, shaders and server configs for Minecraft
APP_DEBUG=1

# Modrinth asks API clients to identify themselves. Not a credential, just a label.
# CurseForge has no default here: its key is a real secret (CURSEFORGE_API_KEY),
# delivered by the platform to /run/base44/app.env.
MODRINTH_USER_AGENT=BlockForge Hub/1.0 (self-hosted Minecraft directory)
